#!/usr/bin/with-contenv bash
set -e

export PATH="/opt/paddock-tools/bin:$PATH"

for dir in /config/.config /config/.local /config/.cache; do
	if [ -d "$dir" ]; then
		chown -R abc:abc "$dir"
	fi
done

# The agent copies these files in as root with mode 0600; abc (setup and boxd serve) must read them.
if [ -d /run/paddock ]; then
	chown -R abc:abc /run/paddock
	chmod 0700 /run/paddock
fi

install -d -o abc -g abc -m 0700 /config/.boxd
touch /config/.boxd/setup.log
chown abc:abc /config/.boxd/setup.log
s6-setuidgid abc boxd setup >> /config/.boxd/setup.log 2>&1 &
